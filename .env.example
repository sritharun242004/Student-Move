FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
R2_ACCOUNT_ID=
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=
R2_REELS_PREFIX=student-reels/reels

