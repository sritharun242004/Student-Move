{
  "name": "student-moves-app",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "pnpm run build:libs && pnpm run build:apps",
    "build:libs": "nest build contracts && nest build postgres-db && nest build mailer && nest build notifications",
    "build:apps": "nest build gateway && nest build merchant-service && nest build reels-service && nest build marketplace-service",
    "build:gateway": "nest build gateway",
    "build:merchant": "nest build merchant-service",
    "build:reels": "nest build reels-service",
    "build:marketplace": "nest build marketplace-service",
    "typeorm:merchant": "typeorm-ts-node-commonjs -d ./typeorm/merchant.datasource.ts",
    "typeorm:reels": "typeorm-ts-node-commonjs -d ./typeorm/reels.datasource.ts",
    "typeorm:marketplace": "typeorm-ts-node-commonjs -d ./typeorm/marketplace.datasource.ts",
    "format": "prettier --write \"apps/**/*.ts\" \"test/**/*.ts\"",
    "migration:merchant:generate": "node ./scripts/merchant-migration.mjs generate",
    "migration:merchant:create": "node ./scripts/merchant-migration.mjs create",
    "migration:merchant:run": "pnpm typeorm:merchant migration:run",
    "migration:merchant:revert": "pnpm typeorm:merchant migration:revert",
    "migration:reels:generate": "node ./scripts/reels-migration.mjs generate",
    "migration:reels:create": "node ./scripts/reels-migration.mjs create",
    "migration:reels:run": "pnpm typeorm:reels migration:run",
    "migration:reels:revert": "pnpm typeorm:reels migration:revert",
    "migration:marketplace:generate": "node ./scripts/marketplace-migration.mjs generate",
    "migration:marketplace:create": "node ./scripts/marketplace-migration.mjs create",
    "migration:marketplace:run": "pnpm typeorm:marketplace migration:run",
    "migration:marketplace:revert": "pnpm typeorm:marketplace migration:revert",
    "start": "pnpm run build && (node dist/apps/merchant-service/main.js & node dist/apps/reels-service/main.js & node dist/apps/marketplace-service/main.js & node dist/apps/gateway/main.js)",
    "start:merchant": "pnpm run build:libs && nest start merchant-service --watch",
    "start:reels": "pnpm run build:libs && nest start reels-service --watch",
    "start:marketplace": "pnpm run build:libs && nest start marketplace-service --watch",
    "start:dev": "pnpm run build:libs && (pnpm run start:merchant & pnpm run start:reels & pnpm run start:marketplace & pnpm run start:gateway)",
    "start:gateway": "pnpm run build:libs && nest start gateway --watch",
    "start:debug": "nest start gateway --debug --watch",
    "start:prod": "node dist/apps/gateway/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./apps/student-moves-app/test/jest-e2e.json"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.896.0",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.3",
    "@nestjs/core": "^11.0.1",
    "@nestjs/microservices": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/typeorm": "^11.0.0",
    "dotenv": "^16.6.1",
    "multer": "^2.0.2",
    "nodemailer": "^8.0.7",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pg": "^8.18.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^6.12.3",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.28"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.18.0",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.19.11",
    "@types/nodemailer": "^8.0.0",
    "@types/passport-jwt": "^4.0.1",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "globals": "^16.0.0",
    "jest": "^30.0.0",
    "prettier": "^3.4.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/apps/",
      "<rootDir>/libs/"
    ],
    "moduleNameMapper": {
      "^@app/contracts(|/.*)$": "<rootDir>/libs/contracts/src/$1",
      "^@app/postgres-db(|/.*)$": "<rootDir>/libs/postgres-db/src/$1"
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": ["@nestjs/core", "unrs-resolver"]
  }
}