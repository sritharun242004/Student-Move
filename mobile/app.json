{
  "expo": {
    "name": "Student Moves",
    "slug": "studentmoves",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "studentmoves",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "uk.co.studentmoves.app",
      "supportsTablet": false
    },
    "android": {
      "package": "uk.co.studentmoves.app",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-video",
      "expo-web-browser",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Student Moves needs access to your photos so you can upload your profile picture, ID documents and reels.",
          "cameraPermission": "Student Moves needs camera access so you can take a profile photo, capture your ID and record reels."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.uk.co.studentmoves.app",
          "enableGooglePay": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "apiBaseUrl": "https://gateway.studentmoves.co.uk/api",
      "mainServiceBaseUrl": "https://api.studentmoves.co.uk",
      "webBaseUrl": "https://studentmoves.co.uk",
      "rentersRightsPdfUrl": "https://cdn.studentmoves.co.uk/public/renters-rights-2026-v1.pdf",
      "rentersRightsPdfVersion": "renters-rights-2026-v1",
      "stripePublishableKey": "pk_test_51S6YhGRrAh6fhypdmNQkfV7dftwgH9NPZJAQYZGUst6TRdVLnelIWm7NcJqqJ09BcZ3v6IzigFgSxBoZY6kEUWWp00YorjhCV3"
    }
  }
}
