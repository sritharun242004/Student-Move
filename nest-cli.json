{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "monorepo": true,
  "compilerOptions": {
    "webpack": false,
    "deleteOutDir": true
  },
  "projects": {
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.app.json"
      }
    },
    "merchant-service": {
      "type": "application",
      "root": "apps/merchant-service",
      "entryFile": "main",
      "sourceRoot": "apps/merchant-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/merchant-service/tsconfig.app.json"
      }
    },
    "reels-service": {
      "type": "application",
      "root": "apps/reels-service",
      "entryFile": "main",
      "sourceRoot": "apps/reels-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/reels-service/tsconfig.app.json"
      }
    },
    "marketplace-service": {
      "type": "application",
      "root": "apps/marketplace-service",
      "entryFile": "main",
      "sourceRoot": "apps/marketplace-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/marketplace-service/tsconfig.app.json"
      }
    },
    "postgres-db": {
      "type": "library",
      "root": "libs/postgres-db",
      "entryFile": "index",
      "sourceRoot": "libs/postgres-db/src",
      "compilerOptions": {
        "tsConfigPath": "libs/postgres-db/tsconfig.lib.json"
      }
    },
    "contracts": {
      "type": "library",
      "root": "libs/contracts",
      "entryFile": "index",
      "sourceRoot": "libs/contracts/src",
      "compilerOptions": {
        "tsConfigPath": "libs/contracts/tsconfig.lib.json"
      }
    },
    "mailer": {
      "type": "library",
      "root": "libs/mailer",
      "entryFile": "index",
      "sourceRoot": "libs/mailer/src",
      "compilerOptions": {
        "tsConfigPath": "libs/mailer/tsconfig.lib.json"
      }
    },
    "notifications": {
      "type": "library",
      "root": "libs/notifications",
      "entryFile": "index",
      "sourceRoot": "libs/notifications/src",
      "compilerOptions": {
        "tsConfigPath": "libs/notifications/tsconfig.lib.json"
      }
    }
  }
}