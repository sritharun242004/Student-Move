# =============================================================================
# StudentMoves Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in the values before running the server.
#
#   cp .env.example .env
#
# Lines marked [REQUIRED] must be set. Lines marked [OPTIONAL] have sensible
# defaults and can be left blank for local development.
# =============================================================================


# -----------------------------------------------------------------------------
# Django Core
# -----------------------------------------------------------------------------

# Django secret key — used for cryptographic signing (sessions, tokens, etc.)
# Generate a strong key with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
# [REQUIRED]
# DO NOT CHANGE PRODUCTION SECRET KEY
SECRET_KEY=

# Allowed hosts for the Django server.
# For local dev: localhost
# For production: your domain, e.g. api.studentmoves.co.uk
# [OPTIONAL — defaults to localhost]
HOST=localhost
HOST2=


# -----------------------------------------------------------------------------
# Environment / Database
# -----------------------------------------------------------------------------

# Set to "production" to use PostgreSQL.
# Leave blank (or omit) to use SQLite — suitable for local development only.
# [OPTIONAL — defaults to SQLite when unset]
DJANGO_ENV=

# PostgreSQL connection details.
# Only required when DJANGO_ENV=production or running via Docker Compose.
# Docker Compose defaults: DB_NAME=mooc, DB_USER=moocuser
# [REQUIRED if DJANGO_ENV=production]
DB_NAME=mooc
DB_USER=moocuser
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432


# -----------------------------------------------------------------------------
# Email (Resend)
# -----------------------------------------------------------------------------

# API key from https://resend.com/api-keys
# Required for any email to be sent (user registration, notifications, etc.)
# [REQUIRED for email functionality]
RESEND_API_KEY=

# The "From" address used in outgoing emails.
# Must be a verified sender domain in your Resend account.
# [OPTIONAL — defaults to info@studentmoves.co.uk]
FROM_EMAIL=info@studentmoves.co.uk

# Email address that receives admin/system notifications.
# [OPTIONAL — defaults to studio@visual-science.co.uk]
ADMIN_EMAIL=studio@visual-science.co.uk


# -----------------------------------------------------------------------------
# Stripe Payments
# -----------------------------------------------------------------------------

# Stripe secret key — used server-side for payment processing.
# Get from: https://dashboard.stripe.com/apikeys
# Use sk_test_... for development, sk_live_... for production.
# [REQUIRED for payment functionality]
STRIPE_SECRET_KEY=

# Stripe webhook signing secret — used to verify incoming webhook events.
# Get from: https://dashboard.stripe.com/webhooks
# [REQUIRED if using Stripe webhooks]
STRIPE_WEBHOOK_SECRET=
