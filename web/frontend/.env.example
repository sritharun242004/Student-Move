# =============================================================================
# StudentMoves Frontend — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values before running the app.
#
#   cp .env.example .env.local
#
# For Docker Compose, copy to .env instead (the Dockerfile reads .env):
#
#   cp .env.example .env
#
# Lines marked [REQUIRED] must be set. Lines marked [OPTIONAL] have sensible
# defaults and can be left blank for local development.
# =============================================================================


# -----------------------------------------------------------------------------
# API URLs
# -----------------------------------------------------------------------------

# Base URL of the Django backend API.
# Local dev:   http://localhost:8000
# Production:  https://api.studentmoves.co.uk
# [REQUIRED]
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL of the optional gateway/marketplace microservice.
# Only needed if the marketplace or reels features are in use.
# [OPTIONAL]
NEXT_PUBLIC_GATEWAY_URL=http://localhost:4000/api


# -----------------------------------------------------------------------------
# NextAuth.js Authentication
# -----------------------------------------------------------------------------

# Secret used to encrypt NextAuth.js session tokens.
# Generate a strong secret with:
#   openssl rand -base64 32
# [REQUIRED]
NEXTAUTH_SECRET=

# The canonical URL of this Next.js app — used by NextAuth.js for redirects.
# Local dev:   http://localhost:3000
# Production:  https://studentmoves.co.uk
# [REQUIRED]
NEXTAUTH_URL=http://localhost:3000


# -----------------------------------------------------------------------------
# Stripe Payments
# -----------------------------------------------------------------------------

# Stripe publishable key — exposed to the browser for client-side payment UI.
# Get from: https://dashboard.stripe.com/apikeys
# Use pk_test_... for development, pk_live_... for production.
# [REQUIRED for payment functionality]
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
